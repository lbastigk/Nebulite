#############################################
# Benchmarking return value transformations
#############################################

echo ---------------------------------------------
echo Starting Transformation Benchmark...
echo ---------------------------------------------

rng off

#############################################
# INFO

# The setSubDoc bottleneck was removed, resulting in a x3 speedup for the transformation benchmark, but the JSON::flush() bottleneck remains.
# JSON::flush() is needed to ensure member integrity,
# but we could optimize to flush only relevant members or finding ways to speed up the cache iteration.
# Perhaps storing references/pointers to each cache element inside a vector. Since partial deletion is very rare,
# syncing the vector with the cache should be fast enough.

#############################################
# Setup

# Values needed for the benchmark
set var "TestValue"
set num 1
set arr[0] 0
set arr[1] 9
set arr[2] 2
set arr[3] 7
set arr[4] 4
set arr[5] 5
set arr[6] 6
set arr[7] 3
set arr[8] 8
set arr[9] 1
set obj.key1 value1
set obj.key2 value2
set obj.key3 value3
set obj.key4 value4

#############################################
# Start renderer for time measurement
set-fps 5000
wait 1

#############################################
# Settings

set benchmark.totalIterationCount 300000
set benchmark.transformationCount 10 # Manually set number of transformations per iteration, see code below

#############################################
# Baseline for all iterations
# Iterate without transformations

# Benchmark:
wait 1
eval set benchmark.baseline.start {global:time.runtime.t}
for i 1 {global:benchmark.totalIterationCount} eval nop --- Add operations below: \
    {global:num} \
    {global:arr} \
    {global:time} \
    {global:arr[0]} \
    {global:obj} \
    {global:arr} \
    {global:arr} \
    {global:arr} \
    {global:arr} \
    {global:var}
wait 1
eval set benchmark.baseline.end {global:time.runtime.t}
eval set benchmark.baseline.delta $({global:benchmark.baseline.end} - {global:benchmark.baseline.start})

#############################################
# Benchmarks

echo
eval echo Running transformation benchmark with {global:benchmark.totalIterationCount} iterations...
wait 10000 # Wait some time to ensure the renderer is fully running
echo

# Benchmark
wait 1
eval set benchmark.test.start {global:time.runtime.t}
for i 1 {global:benchmark.totalIterationCount} eval nop --- Add operations below: \
    {global:num|add 1} \
    {global:arr|subspan 2 2} \
    {global:time|get runtime.dt} \
    {global:arr[0]|toBoolString} \
    {global:obj|listMembers} \
    {global:arr|map add 1} \
    {global:arr|typeAsString} \
    {global:arr|sort numerically} \
    {global:arr|average} \
    {global:var|typeAsString}
wait 1
eval set benchmark.test.end {global:time.runtime.t}
eval set benchmark.test.delta $({global:benchmark.test.end} - {global:benchmark.test.start})

#############################################
# Results

eval set benchmark.result.timePerIteration $({global:benchmark.test.delta} / {global:benchmark.totalIterationCount})
eval set benchmark.result.timePerTransformation $({global:benchmark.test.delta} / ({global:benchmark.totalIterationCount} * {global:benchmark.transformationCount}))

eval set benchmark.result.adjusted.time $(({global:benchmark.test.delta} - {global:benchmark.baseline.delta}))
eval set benchmark.result.adjusted.timePerIteration $({global:benchmark.result.adjusted.time} / {global:benchmark.totalIterationCount})
eval set benchmark.result.adjusted.timePerTransformation $({global:benchmark.result.adjusted.time} / ({global:benchmark.totalIterationCount} * {global:benchmark.transformationCount}))

echo ---------------------------------------------
echo Benchmark Results:
echo ---------------------------------------------
eval echo Total iterations: {global:benchmark.totalIterationCount}
echo
echo Overall Benchmark:

eval echo Benchmark took $6.4f({global:benchmark.test.delta}) seconds
eval echo Average time per iteration:      $06.4f(1e6 * {global:benchmark.result.timePerIteration}) µs
eval echo Average time per transformation: $06.4f(1e6 * {global:benchmark.result.timePerTransformation}) µs
echo
eval echo Estimation just for transformations (subtracting baseline time for {global:benchmark.totalIterationCount} eval iterations: {global:benchmark.baseline.delta} seconds):
eval echo Benchmark took $6.4f({global:benchmark.result.adjusted.time}) seconds
eval echo Average time per iteration:      $06.4f(1e6 * {global:benchmark.result.adjusted.timePerIteration}) µs
eval echo Average time per transformation: $06.4f(1e6 * {global:benchmark.result.adjusted.timePerTransformation}) µs
echo
eval echo $.2f(1 / {global:benchmark.result.adjusted.timePerTransformation} / 1e6) million transformations per second
eval echo Possible transformations at 144fps: $05i((1.0/144.0) / {global:benchmark.result.adjusted.timePerTransformation}) transformations per frame
eval echo Possible transformations at  60fps: $05i((1.0/60.0) / {global:benchmark.result.adjusted.timePerTransformation}) transformations per frame
echo
exit