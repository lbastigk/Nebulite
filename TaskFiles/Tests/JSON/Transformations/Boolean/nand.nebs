# Test logical NAND across multiple arrays.
set allTrue[0] true
set allTrue[1] true
set oneFalse[0] true
set oneFalse[1] false
set allFalse[0] false
set allFalse[1] false
assign global:empty = {|ensureArray}

eval nop {global:allTrue|nand|assert false}
eval nop {global:oneFalse|nand|assert true}
eval nop {global:allFalse|nand|assert true}
eval nop {global:empty|nand|assert false}

exit
