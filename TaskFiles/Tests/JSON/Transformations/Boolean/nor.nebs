# Test logical NOR across multiple arrays.
set allFalse[0] false
set allFalse[1] false
set oneTrue[0] false
set oneTrue[1] true
set allTrue[0] true
set allTrue[1] true
assign global:empty = {|ensureArray}

eval nop {global:allFalse|nor|assert true}
eval nop {global:oneTrue|nor|assert false}
eval nop {global:allTrue|nor|assert false}
eval nop {global:empty|nor|assert true}

exit
